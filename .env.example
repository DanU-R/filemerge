# Koneksi database (Prisma Postgres). Ganti dengan nilai Anda.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Token Vercel Blob (private store) untuk menyimpan file dokumen.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Opsional: batas rate limit (nilai default di kode aman untuk produksi).
# RATE_LIMIT_LOGIN="20"
# RATE_LIMIT_REGISTER="10"

# Catatan: JANGAN pernah commit file .env / .env.local ini.
# Fitur merge tanpa akun tidak memerlukan file ini.
